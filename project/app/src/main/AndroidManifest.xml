<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Read-only vehicle references: seat occupancy, airbag deployment / telltales, gear, door position and lock state. -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <!-- Telltale (warning lamp) reads require the private safety permission on Pleos Connect. -->
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <!-- Escape support the occupant requests explicitly while stopped: door unlock, trunk and window opening. -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />
    <!-- Hard-stop hint (runtime permission). Without it the hint is simply off. -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- Vehicle position for the report card (shown on screen only; nothing is uploaded). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <queries>
        <!-- "Open the phone screen" (ACTION_DIAL) only. The app never places a call by itself. -->
        <intent><action android:name="android.intent.action.DIAL" /><data android:scheme="tel" /></intent>
        <!-- Spoken guidance: lets TextToSpeech find the installed engine (package visibility, Android 11+). -->
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <application android:allowBackup="false" android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules" android:icon="@drawable/ic_launcher"
        android:label="퍼스트가드" android:supportsRtl="true" android:theme="@style/AppTheme">
        <uses-library android:name="android.car" android:required="false" />
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask">
            <!-- Emergency guidance must stay visible even if the vehicle is not reported as parked. -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
